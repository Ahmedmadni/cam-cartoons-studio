# Optional Ready Player Me full-body GLB avatars.
# Leave a value empty to use the built-in redesigned cartoon fallback.
# Example:
# VITE_RPM_BOY_URL=https://models.readyplayer.me/YOUR_AVATAR_ID.glb

VITE_RPM_BOY_URL=
VITE_RPM_GIRL_URL=
VITE_RPM_MAN_URL=
VITE_RPM_WOMAN_URL=

# Optional Ready Player Me partner subdomain used by the embedded creator.
# The UI also lets you change this value at runtime. "demo" can be used for prototyping.
VITE_RPM_SUBDOMAIN=demo


# Optional AI voice synthesis endpoint.
# The endpoint receives JSON and returns an audio file (WAV/MP3/OGG/WebM).
# It can be backed by Coqui TTS, VITS, Bark, or another compatible service.
VITE_VOICE_API_URL=
