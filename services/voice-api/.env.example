COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
COQUI_DEVICE=auto
VOICE_ALLOWED_ORIGINS=http://localhost:5173

# Optional speaker reference fallbacks.
DEFAULT_SPEAKER_WAV=
COQUI_DEFAULT_SPEAKER=

# Optional per-character reference WAV files.
# If omitted, the service also checks /app/voices/<voice>.wav.
VOICE_NORMAL_WAV=
VOICE_CHILD_WAV=
VOICE_BOY_WAV=
VOICE_GIRL_WAV=
VOICE_MAN_WAV=
VOICE_WOMAN_WAV=
